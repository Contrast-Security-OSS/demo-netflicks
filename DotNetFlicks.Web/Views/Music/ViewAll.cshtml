@model DotNetFlicks.ViewModels.Music.AlbumsViewModel

@{
    ViewData["Title"] = Model.IsUserLibrary ? "My Music" : "Browse Music";
}

<div class="d-flex align-items-center mb-4">
    <div>
        <h1 class="mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">
            @(Model.IsUserLibrary ? "Albums you've saved for easy listening." : "Discover albums and add your favorites to your library.")
        </p>
    </div>
    <span class="badge badge-primary badge-pill ml-auto">@Model.Albums.Count albums</span>
</div>

@if (!Model.Albums.Any())
{
    <div class="jumbotron text-center">
        <i class="fas fa-music fa-3x text-muted mb-3"></i>
        <h2>Your music library is empty</h2>
        <p class="lead">Browse the catalog and add an album to start listening.</p>
        <a class="btn btn-primary" asp-controller="Music" asp-action="ViewAll">Browse music</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var album in Model.Albums)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <a asp-controller="Music" asp-action="View" asp-route-id="@album.Id">
                        <img class="card-img-top" src="@album.CoverImageUrl" alt="@album.Title cover">
                    </a>
                    <div class="card-body d-flex flex-column">
                        <span class="badge badge-secondary align-self-start mb-2">@album.Genre</span>
                        <h5 class="card-title mb-1">
                            <a class="custom-link" asp-controller="Music" asp-action="View" asp-route-id="@album.Id">@album.Title</a>
                        </h5>
                        <p class="text-muted">@album.Artist</p>
                        <p class="small mt-auto mb-0">@album.Tracks.Count tracks &middot; @album.ReleaseDate.Year</p>
                    </div>
                    @if (Model.IsUserLibrary)
                    {
                        <div class="card-footer bg-white">
                            <form asp-controller="Music" asp-action="RemoveFromLibrary" asp-route-id="@album.Id" asp-route-returnToLibrary="true" method="post">
                                <button class="btn btn-outline-danger btn-sm btn-block" type="submit">
                                    <i class="fas fa-minus-circle mr-1"></i> Remove
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
